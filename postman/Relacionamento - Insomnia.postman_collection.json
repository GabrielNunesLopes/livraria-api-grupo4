{
  "info": {
    "name": "Livraria API - Relacionamento para Insomnia",
    "description": "Testes do relacionamento entre livros e categorias. Importe no Insomnia usando Import > File.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Relacionamento",
      "item": [
        {
          "name": "Livro vem com a categoria",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/livros/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Veio o nome da categoria\", function () {",
                  "    pm.expect(pm.response.json().categoria).to.eql(\"Tecnologia\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Livro com categoria inexistente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Livro com categoria inválida\",\n  \"autor\": \"Autor de teste\",\n  \"preco\": 25.9,\n  \"estoque\": 3,\n  \"categoria_id\": 99999\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/livros"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Apagar categoria com livros",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/categorias/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 409\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
