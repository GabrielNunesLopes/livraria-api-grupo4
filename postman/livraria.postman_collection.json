  "item": [
    {
      "name": "Livros",
      "item": [
        {
          "name": "1 - Listar livros",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/livros"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"A carga inicial tem pelo menos oito livros\", function () {",
                  "    const livros = pm.response.json();",
                  "    pm.expect(livros).to.be.an(\"array\").that.has.lengthOf.at.least(8);",
                  "});",
                  "pm.test(\"Todos os oito livros iniciais t?m categoria\", function () {",
                  "    const livros = pm.response.json().slice(0, 8);",
                  "    pm.expect(livros.every(livro => livro.categoria_id !== null && livro.categoria !== null)).to.eql(true);",
                  "});",
                  "pm.test(\"Os tr?s livros iniciais continuam primeiro e na mesma ordem\", function () {",
                  "    const titulos = pm.response.json().slice(0, 3).map(livro => livro.titulo);",
                  "    pm.expect(titulos).to.eql([\"Clean Code\", \"Eloquent JavaScript\", \"O Hobbit\"]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2 - Buscar livro inexistente",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/livros/99999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 404\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3 - Cadastrar livro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"O Hobbit\",\n  \"autor\": \"J.R.R. Tolkien\",\n  \"preco\": 39.9,\n  \"estoque\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/livros"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.collectionVariables.set(\"livroId\", pm.response.json().id);",
                  "pm.test(\"O livro criado veio com o t?tulo enviado\", function () {",
                  "    pm.expect(pm.response.json().titulo).to.eql(\"O Hobbit\");",
                  "});",
                  "pm.test(\"Livro sem categoria recebe categoria_id nulo\", function () {",
                  "    pm.expect(pm.response.json().categoria_id).to.eql(null);",
                  "});",
                  "pm.test(\"Livro sem categoria recebe nome de categoria nulo\", function () {",
                  "    pm.expect(pm.response.json().categoria).to.eql(null);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4 - Buscar livro cadastrado",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/livros/{{livroId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"A busca retornou o livro criado\", function () {",
                  "    pm.expect(String(pm.response.json().id)).to.eql(String(pm.collectionVariables.get(\"livroId\")));",
                  "});",
                  "pm.test(\"O nome da categoria continua nulo\", function () {",
                  "    pm.expect(pm.response.json().categoria).to.eql(null);",
                  "});"
                ]
              }
            }
          ]
        },
